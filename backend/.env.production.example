APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (Docker: use service name "mysql")
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

# Auth (cookie JWT)
JWT_SECRET=
JWT_TTL_SECONDS=3600

# Sessions/Cookies (same-origin frontend + /api proxy)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Cache/Queue
CACHE_STORE=redis
QUEUE_CONNECTION=sync

# Redis (Docker: use service name "redis")
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Frontend URL (same as APP_URL in single-domain deployments)
FRONTEND_URL=http://YOUR_PUBLIC_IP_OR_DOMAIN

